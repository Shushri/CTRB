            VALUES 
            ($1, $2, 'cone', true, '{}', 'Cones clean, cages intact.', 'accepted', $3, '2026-06-10T11:00:00Z'),
            ($1, $2, 'cup', true, '{}', 'Raceway looks good.', 'accepted', $3, '2026-06-10T11:10:00Z')
